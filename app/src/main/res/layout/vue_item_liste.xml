<?xml version="1.0" encoding="utf-8"?>
<!-- Vue décrivant la disposition au sein de chaque item de la liste
     qui affiche les photos de Paris.
     Illustration de l'utilisation d'un CardView pour chaque item de
     la liste  -
     fichier vue_item_liste.xml                 -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="2dp"
    app:cardElevation="2dp" >

    <!-- Les CardView possèdent des attributs supplémentaires dont
         - cardBackgroundColor
         - cardElevation pour l'élévation (donc aussi l'ombre)
         - cardCornerRadius pour arrondir les angles
     -->
    <!-- Le CardView présentera : une image, suivie d'un texte -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/marge_horizontale"
        android:layout_marginVertical="@dimen/marge_verticale"
        android:background="@color/couleur_fond"
        android:stretchColumns="0">

        <TableRow >
            <TextView
                android:id="@+id/nom_dept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/grande_taille"
                android:textColor="@color/couleur_texte"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/num_dept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/grande_taille"
                android:textStyle="bold"
                android:textColor="@color/couleur_texte"
                android:layout_column="2"/>
        </TableRow>

        <TableRow
            android:layout_marginBottom="@dimen/marge_verticale">
            <TextView
                android:id="@+id/pop_dept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/couleur_texte"
                android:layout_column="1"/>

            <TextView
                android:text="@string/libelle_habitant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/couleur_texte"
                android:layout_column="1"/>
        </TableRow>


        <TableRow
            android:layout_marginTop="@dimen/marge_verticale">
            <TextView
                android:id="@+id/nom_pref"
                android:layout_width="match_parent"
                android:textColor="@color/couleur_texte2"/>

            <TextView
                android:id="@+id/hab_pref"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/couleur_texte2"/>

            <TextView
                android:text="@string/libelle_habitant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/couleur_texte2"/>
        </TableRow>

        <TableRow>
            <ImageView
                android:id="@+id/image"
                android:layout_marginHorizontal="@dimen/grande_marge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_span="3"/>
        </TableRow>

    </TableLayout>



</androidx.cardview.widget.CardView>
